# Raisonne, every variable in one place.
#
# Copy to .env.local and fill in only what you need. .env* is gitignored, so
# nothing here reaches the repository. Every one of these is optional: with
# none of them set, the catalogue works and the pages that need a key say
# which one is missing instead of failing.
#
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# The catalogue (Wave 1)
# ---------------------------------------------------------------------------

# The site's public address. Canonical URLs, the sitemap, robots.txt,
# structured data and share cards all start here.
RAISONNE_SITE_URL=

# demo serves the demo artist even when src/fixtures/local/site.json exists.
RAISONNE_FIXTURES=

# Extra image hosts for next/image, comma separated. The rest are read from
# the data at start up.
RAISONNE_IMAGE_HOSTS=

# 1 serves the artist's workbench — /import and /design-system — in
# production. /docs is always public (how to build your own). Setting this on
# a public host publishes the workbench URLs to anyone who types them.
# RAISONNE_TOOLS_NAV is legacy and no longer read; tool links appear in the
# footer for an owner session only. Docs + GitHub are public footer links.
RAISONNE_TOOLS=
RAISONNE_TOOLS_NAV=

# 1 closes the site, 0 keeps it open whatever the data says.
RAISONNE_MAINTENANCE=

# The design pack this install wears, and the folder that holds packs
# (<dir>/<id>/pack.json, with pack.css and fonts beside it). Packs are private
# and never ship with the app. Leave both empty for skin zero.
# Live works and films on ipfs.io load through this gateway instead.
RAISONNE_IPFS_GATEWAY=
RAISONNE_SKIN=
RAISONNE_PACK_DIR=
# Optional: a one-line file holding a pack id, read on every request. It replaces
# RAISONNE_SKIN, so the design can be switched without a restart.
RAISONNE_SKIN_FILE=

# The address of a self-hosted Plausible or Umami, when settings.analytics
# names one.
RAISONNE_ANALYTICS_HOST=

# Where a newsletter sign-up is forwarded (POST {email, source}). Without it
# the form is not rendered anywhere.
RAISONNE_NEWSLETTER_URL=

# 1 when a reverse proxy you control sets X-Forwarded-For. Rate limits then
# count per client address instead of counting everything in one bucket.
RAISONNE_TRUSTED_PROXY=

# Where `pnpm snapshot` reads an existing site's catalogue from (read-only
# GETs to that install's /api/proxy).
RAISONNE_CMS_URL=

# ---------------------------------------------------------------------------
# Accounts and collectors (Wave 2)
# ---------------------------------------------------------------------------

# Signs the session cookie. At least 32 characters. Without it nobody can
# sign in and the collector pages say so.
#   openssl rand -base64 32
RAISONNE_SESSION_SECRET=

# The wallets that own this install, comma separated. Signing in with one of
# them opens the artist-only pages. Unset, the minting wallets in the
# catalogue data (artist.wallets) are used instead.
RAISONNE_OWNER_ADDRESSES=

# The domain a sign-in message is bound to, e.g. example.art. Defaults to the
# host of RAISONNE_SITE_URL, then to the request's own host.
RAISONNE_SIWE_DOMAIN=

# How long a session lasts before it is renewed. Default 60, maximum 1440.
RAISONNE_SESSION_TTL_MINUTES=

# An Alchemy key with the NFT API enabled. Read only: holdings, holders and
# transfer events, and the contract call that lets a smart-contract wallet
# sign in. A free key covers an artist-sized catalogue.
#   https://dashboard.alchemy.com
ALCHEMY_API_KEY=

# Which Alchemy networks to read, comma separated (eth-mainnet,base-mainnet).
# Unset, the chains the catalogue actually uses.
RAISONNE_CHAIN_NETWORKS=

# How long a holdings read is cached in memory. Default 300, maximum 3600.
RAISONNE_CHAIN_CACHE_SECONDS=

# ---------------------------------------------------------------------------
# The store (Wave 3)
# ---------------------------------------------------------------------------

# Stripe. Test keys (sk_test_...) are the only ones this theme has been
# exercised with. Prices are always resolved on the server from the
# fixtures, never from the browser.
STRIPE_SECRET_KEY=

# The signing secret of your Stripe webhook endpoint (whsec_...). Without it
# the webhook refuses every request, because an unverified webhook is a
# public button marked "mark this order paid".
STRIPE_WEBHOOK_SECRET=

# Where the JSON order store writes. Default .data/orders. Put it on a disk
# that survives a deploy, or swap the adapter for a database.
RAISONNE_ORDERS_DIR=

# The currency `pnpm snapshot` reads CMS prices as. Default USD.
RAISONNE_STORE_CURRENCY=

# Print on demand. Provider dispatch is a stub in this release: the flow and
# the pages are built, the call to the provider is not.
RAISONNE_POD_PROVIDER=
RAISONNE_POD_API_KEY=

# ---------------------------------------------------------------------------
# App updates (the Raisonne code itself)
# ---------------------------------------------------------------------------
#
# The owner page at /update checks GitHub for a newer release of this app and
# can pull it into a git-based install. Catalogue data, orders and .env files
# are never part of an update.
#
# owner/name of the repository releases are read from. Default:
# orkhan-art-web/raisonne-os
RAISONNE_UPDATE_REPO=

# 1 allows the owner to press Update on /update in production. 0 refuses it
# everywhere. Unset: allowed in development, refused in production. The CLI
# (`pnpm update:raisonne`) does not need this flag.
RAISONNE_UPDATE=

# Optional GitHub token (contents:read) for private forks, or to raise the
# anonymous rate limit on public repos.
RAISONNE_UPDATE_GITHUB_TOKEN=
